    "type": "git",
    "url": "https://github.com/Alecell/mermaid-hotpaths"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.1",
    "ajv": "^8.17.1",
    "chokidar": "3.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.12",
    "express": "^5.2.1",
    "jison": "^0.4.18",
    "js-yaml": "^4.1.1",
    "langium-cli": "^4.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "~5.8.0"
  },
  "pnpm": {
